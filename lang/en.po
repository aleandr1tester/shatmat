msgid "Выберите партию — откроется просмотр с доской и ходами."
msgstr "Pick a game — it opens in review with the board and moves."

msgid "ходов {n} · шахматы {c}, шашки {k} · взятия {cc}/{ck} · смен {f}"
msgstr "moves {n} · chess {c}, checkers {k} · captures {cc}/{ck} · flips {f}"

msgid "Ход {full} из {full_total} · полуход {ply} из {ply_total}"
msgstr "Move {full} of {full_total} · half-move {ply} of {ply_total}"

